---
import { Image } from 'astro:assets';
import HomeIcon from './HomeIcon.astro';
import { locationRegions, regionalPlaces } from '../lib/location-regions';
import { mapDefinitions } from '../lib/map-data';
---
{locationRegions.filter(region => region.id !== 'looty-bay').map(region => (
  <section class="regional-group" data-result-region={region.id} aria-labelledby={'region-' + region.id}>
    <div class="directory-district-head"><span class="directory-code">{region.code}</span><div><h3 id={'region-' + region.id}>{region.name}</h3><p>{region.description}</p></div></div>
    <div class="location-building-grid">{regionalPlaces.filter(place => place.region === region.id).map(place => (
      <details class="regional-place" id={'place-' + place.id} data-regional-place data-region={place.region} data-search-text={place.searchText}>
        <summary class="location-building-summary has-visual">
          <span class="directory-visual directory-visual-art"><Image src={place.artwork.image} width={280} alt={place.artwork.alt} loading="lazy" /><small>Type artwork</small></span>
          <span class="location-building-overview"><span class="location-building-meta"><span class="location-building-district">{region.name}</span><span>Place guide</span></span><span class="location-building-name">{place.name}</span><span class="regional-place-description">{place.description}</span><span class="location-type-tags"><span class="location-type-tag">{place.type}</span></span><span class="location-disclosure"><span class="location-disclosure-open">View place guide</span><span class="location-disclosure-close">Hide place guide</span><HomeIcon name="arrow" size={16} /></span></span>
        </summary>
        <div class="regional-place-body"><p>{place.details}</p><p class="regional-data-note">This is a place reference. Individual loot points are not included in the city’s 927-record dataset.</p><div class="regional-place-links">{mapDefinitions.find(map=>map.id===(place.region==='settlement'?'settlements':place.region))&&<a class="location-text-link" href={mapDefinitions.find(map=>map.id===(place.region==='settlement'?'settlements':place.region))!.path}>Open interactive map <HomeIcon name="pin" size={15}/></a>}<a class="location-text-link" href={place.map}>Community map source <HomeIcon name="external" size={15} /></a><a class="location-text-link" href={place.source}>Read source <HomeIcon name="external" size={15} /></a></div><p class="regional-source-date">Reference checked {place.checkedAt} · ROB RUN Wiki{place.source.includes('robrun.ro') ? ' / RRR' : ''}</p></div>
      </details>
    ))}</div>
  </section>
))}
