---
import sources from '../../assets/home-gameplay/sources.json';
import { homeGameplayEnabled, homeMediaUrl } from '../lib/home-game-media.mjs';

interface Props {
  name: keyof typeof sources;
  small?: keyof typeof sources;
  sizes?: string;
  alt: string;
  priority?: boolean;
  class?: string;
}
const { name, small, sizes, alt, priority = false, class: className } = Astro.props;
// The local poster for these clips is a video frame. Use a published still for the remote version.
const alternateStills: Partial<Record<keyof typeof sources, keyof typeof sources>> = {
  locations: 'hero',
  'mission-start': 'beginner',
  'mission-sale': 'mission-items',
  'mission-timer': 'crew',
  'role-police': 'role-crews',
  'video-cover': 'crew',
};
const alternate = alternateStills[name];
const full = sources[!homeGameplayEnabled && alternate ? alternate : name];
const compact = homeGameplayEnabled && small ? sources[small] : null;
const srcset = compact
  ? homeMediaUrl(compact) + ' ' + compact.width + 'w, ' + homeMediaUrl(full) + ' ' + full.width + 'w'
  : undefined;
---

<img class={className} src={homeMediaUrl(full)} srcset={srcset} sizes={srcset ? sizes : undefined} width={full.width} height={full.height} alt={alt}
  loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" />

