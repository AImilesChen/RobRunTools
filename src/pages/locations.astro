---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locationRecords } from '../lib/location-records';

const districts = [...new Set(locationRecords.map(record => record.district))].sort();
const types = [...new Set(locationRecords.map(record => record.type))].sort();
---

<BaseLayout title="ROB RUN Locations — Looty Bay Directory" description="Browse community location records from Looty Bay by name, district and type.">
  <main>
    <section class="page-hero">
      <span class="watermark" aria-hidden="true">LOCATIONS</span>
      <div class="container">
        <p class="eyebrow">// LOOTY BAY DIRECTORY</p>
        <h1 class="page-title">Locations</h1>
        <p class="page-sub">Browse community location records by name, district or type. <a href="/sources">Data sources</a></p>
        <div class="toolbar">
          <input id="search" type="search" aria-label="Search location names" class="toolbar-search" placeholder="Search location names…" />
          <select id="district" class="toolbar-select" aria-label="District">
            <option value="">All districts</option>
            {districts.map((d) => <option value={d}>{d}</option>)}
          </select>
          <select id="type" class="toolbar-select" aria-label="Location type">
            <option value="">All types</option>
            {types.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <p class="loc-count" id="count" role="status">{locationRecords.length} location records</p>
      </div>
    </section>

    <section class="loc-section">
      <div class="container">
        <div class="loc-grid" id="grid">
          {locationRecords.map((p) => (
            <details id={`record-${p.id}`} class="loc-item" data-name={p.name.toLowerCase()} data-district={p.district} data-type={p.type}>
              <summary>
                <span class="loc-name">{p.name}</span>
                <span class="loc-meta">{p.type} · {p.district}</span>
              </summary>
              <dl>
                <dt>Building in source</dt><dd lang={p.building ? 'ru' : undefined}>{p.building || 'Unknown'}</dd>
                <dt>Recorded loot entries</dt><dd>{p.lootEntries ?? 'Unknown'}</dd>
              </dl>
              <a href={p.url}>View community source</a>
            </details>
          ))}
        </div>
        <div id="locations-empty" hidden>
          <p>No location records match these filters.</p>
          <button id="clear-location-filters" class="btn btn-dark" type="button">Clear filters</button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(90deg, rgba(20, 22, 27, 0.95) 0%, rgba(20, 22, 27, 0.5) 100%);
  }
  .page-title {
    font-size: clamp(44px, 6vw, 72px);
    margin: 12px 0 8px;
  }
  .page-sub {
    color: var(--muted);
    font-size: 17px;
    margin: 0 0 20px;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .toolbar-search {
    flex: 1;
    min-width: min(100%, 220px);
    background: var(--input);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 16px;
    font-size: 15px;
    font-family: var(--font-body);
  }
  .toolbar-search:focus {
    outline: 1px solid var(--accent);
  }
  .toolbar-select {
    background: var(--input);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    font-size: 14px;
    font-family: var(--font-body);
    cursor: pointer;
  }
  .loc-count {
    color: var(--muted);
    font-size: 13px;
    margin: 14px 0 0;
  }

  .loc-section {
    padding: 32px 0 64px;
  }
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .loc-item {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 14px 16px;
    scroll-margin-block-start: 115px;
    overflow-wrap: anywhere;
  }
  .loc-item:target { border-color: var(--accent); }
  .loc-item summary { cursor: pointer; min-height: 44px; }
  .loc-item dl { font-size: 14px; margin: 8px 0; }
  .loc-item dd { margin: 0 0 5px; color: var(--muted); }
  .loc-item a, .page-sub a { color: var(--accent); }
  .loc-name {
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
  }
  .loc-meta {
    color: var(--muted);
    font-size: 12px;
    display: block;
  }
  @media (max-width: 1200px) {
    .loc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .loc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .loc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const search = document.getElementById('search') as HTMLInputElement;
  const districtSel = document.getElementById('district') as HTMLSelectElement;
  const typeSel = document.getElementById('type') as HTMLSelectElement;
  const grid = document.getElementById('grid') as HTMLElement;
  const countEl = document.getElementById('count') as HTMLElement;
  const empty = document.getElementById('locations-empty')!;
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.loc-item'));
  const linkedDistrict = new URLSearchParams(location.search).get('district');
  if (linkedDistrict && Array.from(districtSel.options).some(option => option.value === linkedDistrict)) {
    districtSel.value = linkedDistrict;
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    const d = districtSel.value;
    const t = typeSel.value;
    let visible = 0;
    for (const el of items) {
      el.hidden = !(el.dataset.name?.includes(q) && (!d || el.dataset.district === d) && (!t || el.dataset.type === t));
      if (!el.hidden) visible++;
    }
    empty.hidden = visible > 0;
    countEl.textContent = `${visible} location ${visible === 1 ? 'record' : 'records'}`;
  }

  function clearFilters() {
    search.value = districtSel.value = typeSel.value = '';
    apply();
  }

  function revealRecord() {
    const target = document.getElementById(location.hash.slice(1));
    if (!(target instanceof HTMLDetailsElement) || !grid.contains(target)) return;
    if (target.hidden) clearFilters();
    target.open = true;
    target.scrollIntoView({ block: 'start' });
  }

  search.addEventListener('input', apply);
  districtSel.addEventListener('change', apply);
  typeSel.addEventListener('change', apply);
  document.getElementById('clear-location-filters')!.addEventListener('click', () => { clearFilters(); search.focus(); });
  window.addEventListener('hashchange', revealRecord);
  apply();
  window.addEventListener('pageshow', () => { apply(); revealRecord(); });
</script>
